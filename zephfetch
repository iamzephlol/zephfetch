get_user() { echo "${USER:-$(id -un 2>/dev/null)}"; }
get_kernel() { uname -r; }

get_os() {
    if [ "$IS_WINDOWS" = "1" ]; then
        local ver=$(run_powershell '(Get-CimInstance Win32_OperatingSystem).Caption')
        [ -n "$ver" ] && { echo "$ver"; return; }
        local os_name=$(wmic os get Caption /value 2>/dev/null | grep -oE 'Caption=(.*)' | cut -d= -f2-)
        local os_ver=$(wmic os get Version /value 2>/dev/null | grep -oE 'Version=(.*)' | cut -d= -f2-)
        echo "${os_name:-Windows} ${os_ver:-}"
        return
    fi
    if [ "$IS_TERMUX" = "1" ]; then
        local ver=$(getprop ro.build.version.release 2>/dev/null)
        echo "Android ${ver:-'?'} (Termux)"
    elif [ "$IS_MACOS" = "1" ]; then
        local os_name=$(sw_vers -productName 2>/dev/null)
        local os_ver=$(sw_vers -productVersion 2>/dev/null)
        echo "${os_name:-macOS} ${os_ver:-}"
    elif [ -f /etc/os-release ]; then . /etc/os-release; echo "$PRETTY_NAME"; else uname -s; fi
}

get_wm() {
    if [ "$IS_WINDOWS" = "1" ]; then
        if HAS wmic &>/dev/null; then
            local dwm=$(wmic process where "name='dwm.exe'" get Name /value 2>/dev/null | grep -iE 'name=' | head -n1 | cut -d= -f2-)
            [ -n "$dwm" ] && { echo "Desktop Window Manager (Windows)"; return; }
        fi
        # Fallback: detect common Windows desktop shells
        if HAS powershell.exe || HAS pwsh || HAS powershell; then
            echo "Windows Desktop (Explorer)"
        else
            echo "Windows"
        fi
        return
    fi
    if [ "$IS_TERMUX" = "1" ]; then echo "None (Android)"
    elif [ -n "$HYPRLAND_INSTANCE_SIGNATURE" ]; then
        hyprctl -j version 2>/dev/null | grep -oP '"version":\s*"\K[^"]+' | head -1 | xargs -I{} echo "Hyprland {}"
    elif [ -n "$WAYLAND_DISPLAY" ]; then echo "Wayland ($XDG_CURRENT_DESKTOP)"
    elif [ -n "$DISPLAY" ]; then echo "X11 ($XDG_CURRENT_DESKTOP)"
    elif [ "$IS_MACOS" = "1" ]; then echo "Aqua (macOS)"
    else echo "Unknown"; fi
}

get_disk() {
    local target=/
    if [ "$IS_WINDOWS" = "1" ]; then
        # Use PowerShell for clean byte-to-GB conversion on Windows
        local disk_info
        disk_info=$(run_powershell "try { \$d=Get-CimInstance Win32_LogicalDisk -Filter 'DeviceID=C:'; \$u=\$d.Size-\$d.FreeSpace; \$t=\$d.Size; \$pg=\$u/\$t*100; '{0:N2} / {1:N2} ({2:N0}%)' -f (\$u/1GB),(\$t/1GB),\$pg } catch { 'Unknown' }")
        if [ -n "$disk_info" ]; then
            echo "$disk_info"
        else
            echo "Unknown"
        fi
        return
    fi
    if [ "$IS_MACOS" = "1" ]; then
        df -h / 2>/dev/null | awk 'NR==2 {printf "%s / %s (%s)", $3, $2, $5}'
        return
    fi
    [ "$IS_TERMUX" = "1" ] && target="$HOME"
    df -h "$target" 2>/dev/null | awk 'NR==2 {printf "%s / %s (%s)", $3, $2, $5}'
}
get_memory() {
    if [ "$IS_WINDOWS" = "1" ]; then
        local total_kb free_kb
        if HAS wmic &>/dev/null; then
            total_kb=$(wmic OS get TotalVisibleMemorySize /value 2>/dev/null | grep -iE 'totalvisiblememorysize=' | head -n1 | cut -d= -f2)
            free_kb=$(wmic OS get FreePhysicalMemory /value 2>/dev/null | grep -iE 'freephysicalmemory=' | head -n1 | cut -d= -f2)
        else
            total_kb=$(run_powershell '[math]::Round((Get-CimInstance Win32_OperatingSystem).TotalVisibleMemorySize)')
            free_kb=$(run_powershell '[math]::Round((Get-CimInstance Win32_OperatingSystem).FreePhysicalMemory)')
        fi
        total_kb=${total_kb:-0}
        free_kb=${free_kb:-0}
        if [ "$total_kb" -gt 0 ] 2>/dev/null; then
            local used_kb=$((total_kb - free_kb))
            local total_gb=$(awk "BEGIN {printf \"%.2f\", $total_kb/1024/1024}")
            local used_gb=$(awk "BEGIN {printf \"%.2f\", $used_kb/1024/1024}")
            local pct=$(awk "BEGIN {printf \"%.0f\", $used_kb/$total_kb*100}")
            echo "$used_gb GiB / $total_gb GiB ($pct%)"
        else
            echo "Unknown"
        fi
        return
    fi
    if [ "$IS_MACOS" = "1" ]; then
        local total_bytes=$(sysctl -n hw.memsize 2>/dev/null)
        if [ -n "$total_bytes" ]; then
            local vmstat=$(vm_stat 2>/dev/null)
            local page_size=$(echo "$vmstat" | awk '/page size of/ {gsub(/[^0-9]/,"",$NF); print $NF}')
            page_size=${page_size:-4096}
            local active=$(echo "$vmstat" | awk '/Active pages/ {gsub(/[^0-9]/,"",$NF); print $NF}')
            local wired=$(echo "$vmstat" | awk '/Wired pages/ {gsub(/[^0-9]/,"",$NF); print $NF}')
            local compressed=$(echo "$vmstat" | awk '/Compressed pages/ {gsub(/[^0-9]/,"",$NF); print $NF}')
            active=${active:-0}; wired=${wired:-0}; compressed=${compressed:-0}
            local used_bytes=$(( (active + wired + compressed) * page_size ))
            local total_gb=$(awk "BEGIN {printf \"%.2f\", $total_bytes/1073741824}")
            local used_gb=$(awk "BEGIN {printf \"%.2f\", $used_bytes/1073741824}")
            local pct=$(awk "BEGIN {printf \"%.0f\", $used_bytes/$total_bytes*100}")
            echo "$used_gb GiB / $total_gb GiB ($pct%)"
        else
            echo "Unknown"
        fi
        return
    fi
    if HAS free; then
        free -b | awk 'NR==2 {printf "%.2f GiB / %.2f GiB (%.0f%%)", $3/1024/1024/1024, $2/1024/1024/1024, $3/$2*100}'
    else
        awk '/^MemTotal/ {t=$2} /^MemAvailable/ {a=$2} END {u=t-a; printf "%.2f GiB / %.2f GiB (%.0f%%)", u/1048576, t/1048576, u/t*100}' /proc/meminfo 2>/dev/null
    fi
}

# Detect package managers across distros
get_packages() {
    local total=0 managers=()
    if [ "$IS_WINDOWS" = "1" ]; then
        local c=0 mgr=""
        HAS winget &>/dev/null && { c=$(winget list 2>/dev/null | grep -cE '^[A-Za-z]' || echo 0); mgr="winget"; }
        HAS pip &>/dev/null && { local pc=$(pip list 2>/dev/null | grep -cE '^[A-Za-z]' || echo 0); c=$((c + pc)); mgr="$mgr pip"; }
        HAS npm && { local nc=$(npm list -g --depth=0 2>/dev/null | grep -cE '├─|└─' || echo 0); c=$((c + nc)); mgr="$mgr npm"; }
        HAS choco && { local cc=$(choco list --local-only 2>/dev/null | grep -cE '^\S' || echo 0); c=$((c + cc)); mgr="$mgr choco"; }
        if [ "$c" -gt 0 ] 2>/dev/null; then
            echo "${c} total (${mgr:-unknown})"
        else
            echo "Unknown"
        fi
        return
    fi
    if [ "$IS_TERMUX" = "1" ]; then
        local c=$(dpkg-query -f '.\n' -W 2>/dev/null | wc -l)
        echo "${c:-0} total (dpkg)"
        return
    fi
    HAS pacman && { local c=$(pacman -Q 2>/dev/null | wc -l); total=$((total+c)); managers+=("$c (pacman)"); }
    HAS apt && { local c=$(apt list --installed 2>/dev/null | wc -l); total=$((total+c)); managers+=("$c (apt)"); }
    HAS dnf && { local c=$(dnf list installed 2>/dev/null | wc -l); total=$((total+c)); managers+=("$c (dnf)"); }
    HAS yum && ! HAS dnf && { local c=$(yum list installed 2>/dev/null | wc -l); total=$((total+c)); managers+=("$c (yum)"); }
    HAS zypper && { local c=$(zypper se --installed-only 2>/dev/null | grep '^i' | wc -l); total=$((total+c)); managers+=("$c (zypper)"); }
    HAS emerge && { local c=$(qlist -I 2>/dev/null | wc -l); total=$((total+c)); managers+=("$c (portage)"); }
    # NixOS system profile: direct references of the current system generation
    if [ "$IS_NIXOS" = "1" ] && [ -d /run/current-system ] && HAS nix-store &>/dev/null; then
        local c=$(nix-store -q --references /run/current-system 2>/dev/null | wc -l)
        total=$((total+c)); managers+=("$c (nixos-system)")
    fi
    # Modern nix CLI: nix profile list (replaces nix-env on newer installs)
    if HAS nix &>/dev/null; then
        local c=$(nix profile list 2>/dev/null | grep -c '^Name:')
        total=$((total+c)); managers+=("$c (nix-user)")
    elif HAS nix-env &>/dev/null; then
        # Legacy nix-env (nix on non-NixOS, or older user profiles)
        local c=$(nix-env -q 2>/dev/null | wc -l)
        total=$((total+c)); managers+=("$c (nix)")
    fi
    HAS flatpak && { local c=$(flatpak list --columns=application 2>/dev/null | wc -l); total=$((total+c)); managers+=("$c (flatpak)"); }
    HAS snap && { local c=$(snap list 2>/dev/null | wc -l); total=$((total+c)); managers+=("$c (snap)"); }
    HAS apk && { local c=$(apk info 2>/dev/null | wc -l); total=$((total+c)); managers+=("$c (apk)"); }
    HAS xbps-query && { local c=$(xbps-query -l 2>/dev/null | wc -l); total=$((total+c)); managers+=("$c (xbps)"); }
    HAS brew && { local c=$(( $(brew list --formula 2>/dev/null | wc -l) + $(brew list --cask 2>/dev/null | wc -l) )); total=$((total+c)); managers+=("$c (brew)"); }
    HAS port && { local c=$(port installed 2>/dev/null | wc -l); total=$((total+c)); managers+=("$c (port)"); }
    HAS eopkg && { local c=$(eopkg list - installed 2>/dev/null | wc -l); total=$((total+c)); managers+=("$c (eopkg)"); }
    HAS guix &>/dev/null && { local c=$(guix package 2>/dev/null | grep -cE '^\s+\S'); total=$((total+c)); managers+=("$c (guix)"); }
    HAS pkg && { local c=$(pkg info 2>/dev/null | wc -l); total=$((total+c)); managers+=("$c (pkg)"); }
    HAS cargo && { local c=$(cargo install --list 2>/dev/null | wc -l); total=$((total+c)); managers+=("$c (cargo)"); }
    HAS gem && { local c=$(gem list 2>/dev/null | wc -l); total=$((total+c)); managers+=("$c (gem)"); }
    HAS npm && { local c=$(npm list -g --depth=0 2>/dev/null | wc -l); total=$((total+c)); managers+=("$c (npm)"); }
    HAS pip &>/dev/null && { local c=$(pip list 2>/dev/null | wc -l); total=$((total+c)); managers+=("$c (pip)"); }
    [ ${#managers[@]} -eq 0 ] && echo "Unknown" || echo "$total total (${managers[*]})"
}

get_host() {
    local host=""
    if [ "$IS_WINDOWS" = "1" ]; then
        local brand=$(run_powershell '(Get-CimInstance Win32_ComputerSystem).Manufacturer')
        local model=$(run_powershell '(Get-CimInstance Win32_ComputerSystem).Model')
        [ -n "$brand" ] && [ -n "$model" ] && host="$brand $model"
        [ -z "$host" ] && {
            local wmic_host=$(wmic computersystem get Model /value 2>/dev/null | grep -oE 'Model=(.*)' | cut -d= -f2-)
            [ -n "$wmic_host" ] && host="$wmic_host"
        }
        [ -z "$host" ] && host=$(wmic os get Caption /value 2>/dev/null | grep -oE 'Caption=(.*)' | cut -d= -f2-)
        echo "${host:-Unknown}"
        return
    fi
    if [ "$IS_TERMUX" = "1" ]; then
        local brand=$(getprop ro.product.brand 2>/dev/null) model=$(getprop ro.product.model 2>/dev/null)
        [ -n "$brand" ] && [ -n "$model" ] && host="$brand $model"
        [ -z "$host" ] && host="$brand$model"
    elif [ "$IS_MACOS" = "1" ]; then
        host=$(system_profiler SPHardwareDataType 2>/dev/null | grep "Model Name" | sed 's/.*: //')
        [ -z "$host" ] && host=$(sysctl -n hw.machine 2>/dev/null)
    fi
    [ -z "$host" ] && [ -r /sys/devices/virtual/dmi/id/product_name ] && host=$(cat /sys/devices/virtual/dmi/id/product_name 2>/dev/null)
    [ -z "$host" ] && [ -r /proc/device-tree/model ] && host=$(tr -d '\0' < /proc/device-tree/model 2>/dev/null)
    echo "${host:-Unknown}"
}

get_resolution() {
    if [ "$IS_MACOS" = "1" ]; then
        local res=$(system_profiler SPDisplaysDataType 2>/dev/null | grep -A1 "Resolution" | tail -1 | grep -oE '[0-9]+ x [0-9]+' | tr -d ' ')
        [ -z "$res" ] && res=$(system_profiler SPDisplaysDataType 2>/dev/null | grep -oE '[0-9]+ x [0-9]+' | head -1 | tr -d ' ')
        echo "${res:-Unknown}"
        return
    fi
    if [ "$IS_WINDOWS" = "1" ]; then
        local res=""
        if HAS wmic &>/dev/null; then
            res=$(wmic desktopmonitor get ScreenWidth,ScreenHeight /value 2>/dev/null | grep -iE 'screenwidth|screenheight' | paste -sd'x' - | tr -d ' ')
        fi
        if [ -z "$res" ]; then
            res=$(run_powershell "try { Add-Type -AssemblyName SystemWindowsForms; \$s=[SystemWindows.Forms.Screen]::PrimaryScreen.Bounds; '\$(\$s.Width)x\$(\$s.Height)' } catch { '' }" 2>/dev/null)
        fi
        echo "${res:-Unknown}"
        return
    fi
    if [ "$IS_TERMUX" = "1" ]; then
        local r=$(wm size 2>/dev/null | grep -oE '[0-9]+x[0-9]+' | awk '{r=$0} END{print r}')
        echo "${r:-Unknown}"
    elif HAS hyprctl && [ -n "$HYPRLAND_INSTANCE_SIGNATURE" ]; then
        hyprctl monitors 2>/dev/null | grep -oE '[0-9]+x[0-9]+' | head -1
    elif HAS xrandr && [ -n "$DISPLAY" ]; then
        xrandr --current 2>/dev/null | grep '\*' | head -1 | awk '{print $1}'
    else
        echo "Unknown"
    fi
}

get_cpu() {
    local cpu=""
    if [ "$IS_MACOS" = "1" ]; then
        cpu=$(sysctl -n machdep.cpu.brand_string 2>/dev/null)
        [ -z "$cpu" ] && cpu=$(system_profiler SPHardwareDataType 2>/dev/null | grep "Processor Name" | sed 's/.*: //')
        echo "${cpu:-$(uname -m)}"
        return
    fi
    if [ "$IS_WINDOWS" = "1" ]; then
        cpu=$(run_powershell '(Get-CimInstance Win32_Processor).Name')
        if [ -z "$cpu" ]; then
            cpu=$(wmic cpu get Name /value 2>/dev/null | grep -iE 'name=' | head -n1 | cut -d= -f2- | sed 's/^[[:space:]]*//')
        fi
        # Clean up: remove extra spaces and parenthetical suffixes like "(R)"
        cpu=$(echo "$cpu" | sed 's/[[:space:]]*([Rr])\?$//; s/[[:space:]]*$//')
        echo "${cpu:-$(uname -m)}"
        return
    fi
    if [ "$IS_TERMUX" = "1" ]; then
        cpu=$(getprop ro.soc.model 2>/dev/null)
        [ -z "$cpu" ] && cpu=$(getprop ro.board.platform 2>/dev/null)
        [ -z "$cpu" ] && cpu=$(getprop ro.hardware 2>/dev/null)
        [ -n "$cpu" ] && { echo "$cpu ($(uname -m))"; return; }
    fi
    cpu=$(grep -m1 '^model name' /proc/cpuinfo 2>/dev/null | cut -d: -f2- | sed 's/^[[:space:]]*//')
    [ -z "$cpu" ] && cpu=$(grep -m1 '^Model' /proc/cpuinfo 2>/dev/null | cut -d: -f2- | sed 's/^[[:space:]]*//')
    [ -z "$cpu" ] && cpu=$(grep -m1 '^Hardware' /proc/cpuinfo 2>/dev/null | cut -d: -f2- | sed 's/^[[:space:]]*//')
    echo "${cpu:-$(uname -m)}"
}

get_gpu() {
    if [ "$IS_WINDOWS" = "1" ]; then
        local gpu=""
        if HAS wmic &>/dev/null; then
            gpu=$(wmic path win32_videocontroller get Name /value 2>/dev/null | grep -iE 'name=' | head -n1 | cut -d= -f2- | sed 's/^[[:space:]]*//')
        fi
        [ -z "$gpu" ] && gpu=$(run_powershell '(Get-CimInstance Win32_VideoController).Name')
        echo "${gpu:-Unknown}"
        return
    fi
    if [ "$IS_MACOS" = "1" ]; then
        local gpu=$(system_profiler SPDisplaysDataType 2>/dev/null | grep -A1 "Graphics/Display" | tail -1 | sed 's/.*: //; s/^[[:space:]]*//')
        [ -z "$gpu" ] && gpu=$(system_profiler SPDisplaysDataType 2>/dev/null | grep "Chipset" | head -1 | sed 's/.*: //; s/^[[:space:]]*//')
        echo "${gpu:-Unknown}"
        return
    fi
    if [ "$IS_TERMUX" = "1" ]; then
        case $(getprop ro.hardware.egl 2>/dev/null) in
            adreno) echo "Qualcomm Adreno"; return ;;
            mali) echo "ARM Mali"; return ;;
            powervr) echo "Imagination PowerVR"; return ;;
        esac
        echo "Unknown"; return
    fi
    local gpu=""
    HAS lspci &>/dev/null && gpu=$(lspci 2>/dev/null | grep -iE 'vga|3d controller|display controller' | head -1 | cut -d: -f3- | sed 's/^[[:space:]]*//; s/\[(rev[^])]*\]//; s/([^)]*) *$//')
    echo "${gpu:-Unknown}"
}

get_swap() {
    if [ "$IS_WINDOWS" = "1" ]; then
        # Windows uses pagefile.sys instead of swap; report its size if available
        local pf_size
        pf_size=$(run_powershell 'Get-CimInstance Win32_PageFileUsage | Select-Object AllocatedBaseSize | ForEach-Object { $_.AllocatedBaseSize }' 2>/dev/null)
        if [ -n "$pf_size" ] && [ "$pf_size" -gt 0 ] 2>/dev/null; then
            local pf_gb=$(awk "BEGIN {printf \"%.2f\", $pf_size/1024}")
            echo "$pf_gb GiB (pagefile.sys)"
        else
            echo "None (Windows uses pagefile.sys)"
        fi
        return
    fi
    if [ "$IS_MACOS" = "1" ]; then
        local swap_info=$(sysctl -n vm.swapusage 2>/dev/null)
        if [ -n "$swap_info" ]; then
            local swap_total=$(echo "$swap_info" | awk '{print $2}' | tr -d 'M')
            local swap_used=$(echo "$swap_info" | awk '{print $4}' | tr -d 'M')
            if [ "${swap_total:-0}" -gt 0 ] 2>/dev/null; then
                local used_gb=$(awk "BEGIN {printf \"%.2f\", $swap_used/1024}")
                local total_gb=$(awk "BEGIN {printf \"%.2f\", $swap_total/1024}")
                local pct=$(awk "BEGIN {printf \"%.0f\", $swap_used/$swap_total*100}")
                echo "$used_gb GiB / $total_gb GiB ($pct%)"
            else
                echo "None"
            fi
        else
            echo "None"
        fi
        return
    fi
    if HAS free; then
        free -b 2>/dev/null | awk 'NR==3 {if ($2 > 0) printf "%.2f GiB / %.2f GiB (%.0f%%)", $3/1073741824, $2/1073741824, $3/$2*100; else print "None"}'
    else
        awk '/^SwapTotal/ {t=$2} /^SwapFree/ {f=$2} END {if (t > 0) printf "%.2f GiB / %.2f GiB (%.0f%%)", (t-f)/1048576, t/1048576, (t-f)/t*100; else print "None"}' /proc/meminfo 2>/dev/null
    fi
}

get_uptime() {
    if [ "$IS_MACOS" = "1" ]; then
        local up=$(uptime 2>/dev/null | sed 's/^up //; s/,.*//')
        echo "${up:-Unknown}"
        return
    fi
    if [ "$IS_WINDOWS" = "1" ]; then
        local up=""
        if HAS wmic &>/dev/null; then
            local boot=$(wmic os get LastBootUpTime /value 2>/dev/null | grep -iE 'lastbootuptime=' | head -n1 | cut -d= -f2-)
            if [ -n "$boot" ]; then
                # WMI timestamp: 20240115123456.000000+000
                local year=${boot:0:4} month=${boot:4:2} day=${boot:6:2}
                local hour=${boot:8:2} min=${boot:10:2} sec=${boot:12:2}
                local boot_epoch=$(date -u -d "${year}-${month}-${day} ${hour}:${min}:${sec}" +%s 2>/dev/null)
                local now_epoch=$(date -u +%s 2>/dev/null)
                if [ -n "$boot_epoch" ] && [ -n "$now_epoch" ]; then
                    local diff=$((now_epoch - boot_epoch))
                    local d=$((diff/86400)) h=$((diff%86400/3600)) m=$((diff%3600/60))
                    up="${d}d ${h}h ${m}m"
                fi
            fi
        fi
        # Fallback via PowerShell if wmic failed
        if [ -z "$up" ]; then
            local uptime_ms=$(run_powershell 'Get-CimInstance Win32_OperatingSystem | ForEach-Object { $_.LastBootUpTime }' 2>/dev/null)
            if [ -n "$uptime_ms" ]; then
                up=$(awk -v ts="$uptime_ms" 'BEGIN{
                    gsub(/[-:T]/," ",ts); sub(/\.[0-9]+/,"",ts); sub(/[+-][0-9]+$/,"",ts)
                    cmd="date -u -d \""ts"\" +%s 2>/dev/null"
                    cmd | getline bt; close(cmd)
                    cmd="date -u +%s"; cmd | getline now; close(cmd)
                    if (bt && now) { d=int((now-bt)/86400); h=int(((now-bt)%86400)/3600); m=int(((now-bt)%3600)/60); printf "%dd %dh %dm", d, h, m }
                    else print "Unknown"
                }')
            fi
        fi
        echo "${up:-Unknown}"
        return
    fi
    local up=$(uptime -p 2>/dev/null | sed 's/^up //')
    [ -z "$up" ] && up=$(awk '{printf "%dd %dh %dm", int($1/86400), int($1%86400/3600), int($1%3600/60)}' /proc/uptime 2>/dev/null)
    echo "${up:-Unknown}"
}

get_shell() {
    if [ "$IS_WINDOWS" = "1" ]; then
        echo "${SHELL:-$(cmd /c echo %COMSPEC% 2>/dev/null || echo 'cmd')}"
        return
    fi
    echo "${SHELL##*/}"
}

get_terminal() {
    if [ "$IS_TERMUX" = "1" ]; then echo "Termux"
    elif [ -n "$WT_SESSION" ]; then echo "Windows Terminal"
    elif [ -n "$ConEmuANSI" ]; then echo "ConEmu"
    elif [ -n "$TERM_PROGRAM" ]; then echo "$TERM_PROGRAM"
    elif [ -n "$KITTY_WINDOW_ID" ]; then echo "kitty"
    elif [ -n "$WEZTERM_PANE" ]; then echo "wezterm"
    elif [ "$IS_WINDOWS" = "1" ]; then echo "Windows ($(basename "$SHELL" 2>/dev/null || echo cmd))"
    else echo "${TERM:-Unknown}"
    fi
}

