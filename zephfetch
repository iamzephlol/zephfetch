#!/bin/bash

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
WHITE='\033[0;37m'
BOLD='\033[1m'
RESET='\033[0m'

# Global variable for custom image
CUSTOM_IMAGE=""

display_image() {
    local image_path="$1"
    if [ ! -f "$image_path" ]; then
        echo -e "${RED}Image not found: $image_path${RESET}"
        return 1
    fi

    # Full quality only - use graphics protocols when available
    if command -v chafa &>/dev/null; then
        # Detect terminal capabilities for best quality
        if [ -n "$KITTY_WINDOW_ID" ] || [ "$TERM" = "xterm-kitty" ]; then
            # Kitty graphics protocol - highest quality
            chafa --format=kitty "$image_path"
        elif [ -n "$WEZTERM_PANE" ] || [ "$TERM" = "wezterm" ]; then
            # WezTerm supports sixels
            chafa --format=sixels "$image_path"
        elif [ -n "$ITERM_SESSION_ID" ] || [ "$TERM_PROGRAM" = "iTerm.app" ]; then
            # iTerm2 supports sixels
            chafa --format=sixels "$image_path"
        elif [ -n "$VTE_VERSION" ] || [ "$TERM" = "xterm-256color" ] || [ "$TERM" = "screen-256color" ] || [ "$TERM" = "tmux-256color" ]; then
            # VTE-based terminals (gnome-terminal, tilix, etc.) support sixels
            chafa --format=sixels "$image_path"
        else
            # Fallback: try sixels first, then kitty, then high-quality symbols
            chafa --format=sixels "$image_path" 2>/dev/null \
                || chafa --format=kitty "$image_path" 2>/dev/null \
                || chafa --symbols=block+space --color-space=rgb --dither=none "$image_path"
        fi
    elif command -v kitty &>/dev/null && [ -n "$KITTY_WINDOW_ID" ]; then
        # Kitty's native icat
        kitty +kitten icat "$image_path"
    else
        echo -e "${RED}Full-quality image display requires 'chafa' (install: pacman -S chafa / apt install chafa / dnf install chafa)${RESET}"
        echo -e "${YELLOW}For best quality, use a terminal with graphics protocol support: kitty, wezterm, iTerm2, or any VTE-based terminal (gnome-terminal, tilix, etc.)${RESET}"
        return 1
    fi
}

print_usage() {
    cat << 'EOF'
Usage: zephfetch [OPTIONS]

Options:
  --image PATH    Display custom image instead of random cat ASCII art
  --help, -h      Show this help message

Examples:
  zephfetch
  zephfetch --image ~/Pictures/cat.png
  zephfetch --image /path/to/image.jpg
EOF
}

