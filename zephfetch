self_update() {
    echo -e "${CYAN}Checking for updates...${RESET}"

    # Get current version (from script content hash)
    local current_hash=$(sha256sum "$0" 2>/dev/null | cut -d' ' -f1)

    # Fetch latest version
    local temp_file=$(mktemp)
    if ! curl -fsSL "$ZEPHFETCH_RAW" -o "$temp_file" 2>/dev/null; then
        echo -e "${RED}Failed to fetch latest version${RESET}"
        rm -f "$temp_file"
        return 1
    fi

    local latest_hash=$(sha256sum "$temp_file" 2>/dev/null | cut -d' ' -f1)

    if [ "$current_hash" = "$latest_hash" ]; then
        echo -e "${GREEN}Already up to date!${RESET}"
        rm -f "$temp_file"
        return 0
    fi

    echo -e "${YELLOW}Update available. Installing...${RESET}"

    # Backup current version
    cp "$0" "$0.bak" 2>/dev/null

    # Install new version
    if mv "$temp_file" "$0" && chmod +x "$0"; then
        echo -e "${GREEN}Updated successfully!${RESET}"
        echo -e "${CYAN}Run 'zephfetch' to use the new version${RESET}"
        return 0
    else
        echo -e "${RED}Update failed, restoring backup...${RESET}"
        mv "$0.bak" "$0" 2>/dev/null
        rm -f "$temp_file"
        return 1
    fi
}

# Theme definitions - completely different layouts
apply_theme() {
    case "$THEME" in
        thm1|default|classic)
            # Classic box (original)
            STYLE="box"
            T_CAT="${CYAN}"
            T_BOX="${BOLD}"
            T_LABEL="${CYAN}"
            T_VALUE="${WHITE}"
            T_ICON="${CYAN}"
            ;;
        thm2|side|columns)
            # Side-by-side two columns
            STYLE="side"
            T_CAT="${MAGENTA}"
            T_LABEL="${BRIGHT_CYAN}"
            T_VALUE="${WHITE}"
            T_ICON="${BRIGHT_CYAN}"
            ;;
        thm3|tree|branch)
            # Tree/branch style
            STYLE="tree"
            T_CAT="${GREEN}"
            T_LABEL="${BRIGHT_GREEN}"
            T_VALUE="${WHITE}"
            T_ICON="${BRIGHT_GREEN}"
            ;;
        thm4|clean|lines)
            # Clean horizontal separators
            STYLE="clean"
            T_CAT="${BLUE}"
            T_LABEL="${BRIGHT_BLUE}"
            T_VALUE="${WHITE}"
            T_ICON="${BRIGHT_BLUE}"
            ;;
        thm5|card|panel)
            # Card/panel style with rounded corners
            STYLE="card"
            T_CAT="${YELLOW}"
            T_LABEL="${BRIGHT_YELLOW}"
            T_VALUE="${WHITE}"
            T_ICON="${BRIGHT_YELLOW}"
            ;;
        thm6|vertical|list)
            # Vertical list with icons on left, no box
            STYLE="vertical"
            T_CAT="${RED}"
            T_LABEL="${BRIGHT_RED}"
            T_VALUE="${WHITE}"
            T_ICON="${BRIGHT_RED}"
            ;;
        thm7|dots|minimal)
            # Minimal with dot separators
            STYLE="dots"
            T_CAT="${CYAN}"
            T_LABEL="${BRIGHT_CYAN}"
            T_VALUE="${WHITE}"
            T_ICON="${BRIGHT_CYAN}"
            ;;
        thm8|retro|oldschool)
            # Retro/oldschool terminal style
            STYLE="retro"
            T_CAT="${GREEN}"
            T_LABEL="${GREEN}"
            T_VALUE="${WHITE}"
            T_ICON="${GREEN}"
            ;;
        thm9|json|raw)
            # JSON-like output
            STYLE="json"
            T_CAT="${MAGENTA}"
            T_LABEL="${BRIGHT_MAGENTA}"
            T_VALUE="${WHITE}"
            T_ICON="${BRIGHT_MAGENTA}"
            ;;
        thm10|compact|one)
            # Compact single line
            STYLE="compact"
            T_CAT="${BRIGHT_WHITE}"
            T_LABEL="${BRIGHT_WHITE}"
            T_VALUE="${WHITE}"
            T_ICON="${BRIGHT_WHITE}"
            ;;
        *)
            # Default to classic
            STYLE="box"
            T_CAT="${CYAN}"
            T_BOX="${BOLD}"
            T_LABEL="${CYAN}"
            T_VALUE="${WHITE}"
            T_ICON="${CYAN}"
            ;;
    esac
}

