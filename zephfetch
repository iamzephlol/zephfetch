    local kernel=$(get_kernel)
    local os=$(get_os)
    local wm=$(get_wm)
    local disk=$(get_disk)
    local memory=$(get_memory)
    local packages=$(get_packages)

    # Apply theme
    apply_theme

    # Print cat/image
    if [ -n "$CUSTOM_IMAGE" ]; then
        display_image "$CUSTOM_IMAGE"
        echo ""
    else
        echo -e "${T_CAT}$(get_random_cat)${RESET}"
        echo ""
    fi

    local hostname=$(cat /etc/hostname 2>/dev/null || uname -n)

    case "$STYLE" in
        minimal)
            # Minimal - just key:value pairs
            echo -e "${T_LABEL}󰣇 user${RESET}     ${T_VALUE}${user}${RESET}"
            echo -e "${T_LABEL}󰌛 kernel${RESET}   ${T_VALUE}${kernel}${RESET}"
            echo -e "${T_LABEL}󰌽 os${RESET}       ${T_VALUE}${os}${RESET}"
            echo -e "${T_LABEL}󰒺 wm${RESET}       ${T_VALUE}${wm}${RESET}"
