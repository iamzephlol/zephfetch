#!/bin/bash

# ANSI color codes
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
WHITE='\033[0;37m'
BOLD='\033[1m'
RESET='\033[0m'

BRIGHT_RED='\033[1;31m'
BRIGHT_GREEN='\033[1;32m'
BRIGHT_YELLOW='\033[1;33m'
BRIGHT_BLUE='\033[1;34m'
BRIGHT_MAGENTA='\033[1;35m'
BRIGHT_CYAN='\033[1;36m'
BRIGHT_WHITE='\033[1;37m'

DIM='\033[2m'

# Global config lol
CUSTOM_IMAGE=""
THEME="default"
MORE_INFO="0"

# GitHub raw URL for self-update
ZEPHFETCH_RAW="https://raw.githubusercontent.com/iamzephlol/zephfetch/main/zephfetch"

self_update() {
    echo -e "${CYAN}Checking for updates...${RESET}"
    local current_hash=$(sha256sum "$0" 2>/dev/null | cut -d' ' -f1)
    local temp_file=$(mktemp)
    if ! curl -fsSL "$ZEPHFETCH_RAW" -o "$temp_file" 2>/dev/null; then
        echo -e "${RED}Failed to fetch latest version${RESET}"
        rm -f "$temp_file"
        return 1
    fi
    local latest_hash=$(sha256sum "$temp_file" 2>/dev/null | cut -d' ' -f1)
    if [ "$current_hash" = "$latest_hash" ]; then
        echo -e "${GREEN}Already up to date!${RESET}"
        rm -f "$temp_file"
        return 0
    fi
    echo -e "${YELLOW}Update available. Installing...${RESET}"
    cp "$0" "$0.bak" 2>/dev/null
    if mv "$temp_file" "$0" && chmod +x "$0"; then
        echo -e "${GREEN}Updated successfully!${RESET}"
        echo -e "${CYAN}Run 'zephfetch' to use the new version${RESET}"
        return 0
    else
        echo -e "${RED}Update failed, restoring backup...${RESET}"
        mv "$0.bak" "$0" 2>/dev/null
        rm -f "$temp_file"
        return 1
    fi
}

# Theme config: sets STYLE + color vars for each layout
apply_theme() {
    case "$THEME" in
        thm1|default|classic) STYLE="box";      T_CAT="${CYAN}";      T_BOX="${BOLD}";      T_LABEL="${CYAN}";      T_VALUE="${WHITE}"; T_ICON="${CYAN}" ;;
        thm2|side|columns)    STYLE="side";     T_CAT="${MAGENTA}";   T_LABEL="${BRIGHT_CYAN}"; T_VALUE="${WHITE}"; T_ICON="${BRIGHT_CYAN}" ;;
        thm3|tree|branch)     STYLE="tree";     T_CAT="${GREEN}";     T_LABEL="${BRIGHT_GREEN}";  T_VALUE="${WHITE}"; T_ICON="${BRIGHT_GREEN}" ;;
        thm4|clean|lines)     STYLE="clean";    T_CAT="${BLUE}";      T_LABEL="${BRIGHT_BLUE}";   T_VALUE="${WHITE}"; T_ICON="${BRIGHT_BLUE}" ;;
        thm5|card|panel)      STYLE="card";     T_CAT="${YELLOW}";    T_LABEL="${BRIGHT_YELLOW}"; T_VALUE="${WHITE}"; T_ICON="${BRIGHT_YELLOW}" ;;
        thm6|vertical|list)   STYLE="vertical"; T_CAT="${RED}";       T_LABEL="${BRIGHT_RED}";    T_VALUE="${WHITE}"; T_ICON="${BRIGHT_RED}" ;;
        thm7|dots|minimal)    STYLE="dots";     T_CAT="${CYAN}";      T_LABEL="${BRIGHT_CYAN}";   T_VALUE="${WHITE}"; T_ICON="${BRIGHT_CYAN}" ;;
        thm8|retro|oldschool) STYLE="retro";    T_CAT="${GREEN}";     T_LABEL="${GREEN}";         T_VALUE="${WHITE}"; T_ICON="${GREEN}" ;;
        thm9|json|raw)        STYLE="json";     T_CAT="${MAGENTA}";   T_LABEL="${BRIGHT_MAGENTA}"; T_VALUE="${WHITE}"; T_ICON="${BRIGHT_MAGENTA}" ;;
        thm10|compact|one)    STYLE="compact";  T_CAT="${BRIGHT_WHITE}"; T_LABEL="${BRIGHT_WHITE}"; T_VALUE="${WHITE}"; T_ICON="${BRIGHT_WHITE}" ;;
        *) STYLE="box"; T_CAT="${CYAN}"; T_BOX="${BOLD}"; T_LABEL="${CYAN}"; T_VALUE="${WHITE}"; T_ICON="${CYAN}" ;;
    esac
}

list_themes() {
    echo -e "${BOLD}Available themes:${RESET}"
    echo "  thm1, default, classic  - Classic box (original)"
    echo "  thm2, side, columns     - Side-by-side two columns"
    echo "  thm3, tree, branch      - Tree/branch style"
    echo "  thm4, clean, lines      - Clean horizontal separators"
    echo "  thm5, card, panel       - Card/panel with rounded corners"
    echo "  thm6, vertical, list    - Vertical list, icons left"
    echo "  thm7, dots, minimal     - Minimal with dot separators"
    echo "  thm8, retro, oldschool  - Retro terminal style"
    echo "  thm9, json, raw         - JSON-like output"
    echo "  thm10, compact, one     - Compact single line"
}

# Render image via chafa (graphics protocols); GIF/WebP/APNG animate for ZEPHFETCH_GIF_DURATION secs (default 3)
display_image() {
    local image_path="$1"
    [ ! -f "$image_path" ] && { echo -e "${RED}Image not found: $image_path${RESET}"; return 1; }

    local animated=0 mime=""
    command -v file &>/dev/null && mime=$(file --brief --mime-type "$image_path" 2>/dev/null)
    case "$mime" in
        image/gif|image/webp|image/apng|image/avif|image/jxl) animated=1 ;;
        *)
            case "${image_path##*.}" in
                gif|GIF|webp|WEBP|apng|APNG|avif|AVIF|jxl|JXL) animated=1 ;;
            esac ;;
    esac

    if command -v chafa &>/dev/null; then
        local dur=()
        [ $animated -eq 1 ] && dur=(-d "${ZEPHFETCH_GIF_DURATION:-3}")
        if [ -n "$KITTY_WINDOW_ID" ] || [ "$TERM" = "xterm-kitty" ]; then
            # kitty icat animates natively at full quality
            if [ $animated -eq 1 ] && command -v kitty &>/dev/null; then
                kitty +kitten icat "$image_path" && return 0
            fi
            chafa "${dur[@]}" --format=kitty "$image_path" 2>/dev/null || chafa --format=kitty "$image_path"
        elif [ -n "$WEZTERM_PANE" ] || [ "$TERM" = "wezterm" ]; then
            chafa "${dur[@]}" --format=sixels "$image_path" 2>/dev/null || chafa --format=sixels "$image_path"
        elif [ -n "$ITERM_SESSION_ID" ] || [ "$TERM_PROGRAM" = "iTerm.app" ]; then
            chafa "${dur[@]}" --format=sixels "$image_path" 2>/dev/null || chafa --format=sixels "$image_path"
        elif [ -n "$VTE_VERSION" ] || [ "$TERM" = "xterm-256color" ] || [ "$TERM" = "screen-256color" ] || [ "$TERM" = "tmux-256color" ]; then
            chafa "${dur[@]}" --format=sixels "$image_path" 2>/dev/null || chafa --format=sixels "$image_path"
        else
            chafa "${dur[@]}" --format=sixels "$image_path" 2>/dev/null \
                || chafa "${dur[@]}" --format=kitty "$image_path" 2>/dev/null \
                || chafa "${dur[@]}" --symbols=block+space --color-space=rgb --dither=none "$image_path" 2>/dev/null \
                || chafa --format=sixels "$image_path" 2>/dev/null \
                || chafa --format=kitty "$image_path" 2>/dev/null \
                || chafa --symbols=block+space --color-space=rgb --dither=none "$image_path"
        fi
    elif command -v timg &>/dev/null; then
        timeout 6 timg "$image_path" 2>/dev/null || true
    elif command -v kitty &>/dev/null && [ -n "$KITTY_WINDOW_ID" ]; then
        kitty +kitten icat "$image_path"
    else
        echo -e "${RED}Requires 'chafa' for image display${RESET}"
        return 1
    fi
}

print_usage() {
    cat << 'EOF'
Usage: zephfetch [OPTIONS]

Options:
  --image PATH       Display custom image or animated GIF instead of cat ASCII art
  --update, -u       Update zephfetch to latest version from GitHub
  --theme NAME, -t   Set theme (thm1-thm10, side, tree, clean, card, vertical, dots, retro, json, compact)
  --thm1..--thm10    Quick theme switch (same as --theme thmN)
  -mi, --more-info   Show extended info (host, resolution, cpu, gpu, swap, shell, terminal, uptime)
  --list-themes      List all available themes
  --help, -h         Show this help message
EOF
}

