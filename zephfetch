get_user() {
    echo "$USER"
}

get_kernel() {
    uname -r
}

get_os() {
    if [ -f /etc/os-release ]; then
        . /etc/os-release
        echo "$PRETTY_NAME"
    else
        uname -s
    fi
}

get_wm() {
    if [ -n "$HYPRLAND_INSTANCE_SIGNATURE" ]; then
        hyprctl -j version 2>/dev/null | grep -oP '"version":\s*"\K[^"]+' | head -1 | xargs -I{} echo "Hyprland {}"
    elif [ -n "$WAYLAND_DISPLAY" ]; then
        echo "Wayland ($XDG_CURRENT_DESKTOP)"
    elif [ -n "$DISPLAY" ]; then
        echo "X11 ($XDG_CURRENT_DESKTOP)"
    else
        echo "Unknown"
    fi
}

get_disk() {
    df -h / | awk 'NR==2 {printf "%s / %s (%s)", $3, $2, $5}'
}

get_memory() {
    free -b | awk 'NR==2 {printf "%.2f GiB / %.2f GiB (%.0f%%)", $3/1024/1024/1024, $2/1024/1024/1024, $3/$2*100}'
}

get_packages() {
    local total=0
    local managers=()

    # pacman (Arch, Manjaro, EndeavourOS, etc.)
    if command -v pacman &>/dev/null; then
        local count=$(pacman -Q 2>/dev/null | wc -l)
        total=$((total + count))
        managers+=("$count (pacman)")
    fi

    # apt (Debian, Ubuntu, Mint, Pop!_OS, etc.)
    if command -v apt &>/dev/null; then
        local count=$(apt list --installed 2>/dev/null | wc -l)
        total=$((total + count))
        managers+=("$count (apt)")
    fi

    # dnf (Fedora, RHEL, CentOS, etc.)
    if command -v dnf &>/dev/null; then
        local count=$(dnf list installed 2>/dev/null | wc -l)
        total=$((total + count))
        managers+=("$count (dnf)")
    fi

    # yum (older RHEL/CentOS)
    if command -v yum &>/dev/null && ! command -v dnf &>/dev/null; then
        local count=$(yum list installed 2>/dev/null | wc -l)
        total=$((total + count))
        managers+=("$count (yum)")
    fi

    # zypper (openSUSE)
    if command -v zypper &>/dev/null; then
        local count=$(zypper se --installed-only 2>/dev/null | grep '^i' | wc -l)
        total=$((total + count))
        managers+=("$count (zypper)")
    fi

    # emerge (Gentoo)
    if command -v emerge &>/dev/null; then
        local count=$(qlist -I 2>/dev/null | wc -l)
        total=$((total + count))
        managers+=("$count (portage)")
    fi

    # nix (NixOS)
    if command -v nix-env &>/dev/null; then
        local count=$(nix-env -q 2>/dev/null | wc -l)
        total=$((total + count))
        managers+=("$count (nix)")
    fi

    # flatpak (universal)
    if command -v flatpak &>/dev/null; then
        local count=$(flatpak list --columns=application 2>/dev/null | wc -l)
        total=$((total + count))
        managers+=("$count (flatpak)")
    fi

    # snap (Ubuntu, etc.)
    if command -v snap &>/dev/null; then
        local count=$(snap list 2>/dev/null | wc -l)
        total=$((total + count))
        managers+=("$count (snap)")
    fi

    # apk (Alpine)
    if command -v apk &>/dev/null; then
        local count=$(apk info 2>/dev/null | wc -l)
        total=$((total + count))
        managers+=("$count (apk)")
    fi

    # xbps (Void Linux)
    if command -v xbps-query &>/dev/null; then
        local count=$(xbps-query -l 2>/dev/null | wc -l)
        total=$((total + count))
        managers+=("$count (xbps)")
    fi

    if [ ${#managers[@]} -eq 0 ]; then
        echo "Unknown"
    else
        echo "$total total (${managers[*]})"
    fi
}

print_fetch() {
    local user=$(get_user)
    local kernel=$(get_kernel)
    local os=$(get_os)
    local wm=$(get_wm)
    local disk=$(get_disk)
    local memory=$(get_memory)
    local packages=$(get_packages)

    if [ -n "$CUSTOM_IMAGE" ]; then
        display_image "$CUSTOM_IMAGE"
        echo ""
    else
        echo -e "${CYAN}$(get_random_cat)${RESET}"
        echo ""
    fi

    local hostname=$(cat /etc/hostname 2>/dev/null || uname -n)
    echo -e "  ${BOLD}╭─${user}@${hostname}─╮${RESET}"
    echo -e "  ${BOLD}│${RESET}  ${CYAN}󰣇 user${RESET}     ${WHITE}${user}${RESET}"
    echo -e "  ${BOLD}│${RESET}  ${CYAN}󰌛 kernel${RESET}   ${WHITE}${kernel}${RESET}"
    echo -e "  ${BOLD}│${RESET}  ${CYAN}󰌽 os${RESET}       ${WHITE}${os}${RESET}"
    echo -e "  ${BOLD}│${RESET}  ${CYAN}󰒺 wm${RESET}       ${WHITE}${wm}${RESET}"
    echo -e "  ${BOLD}│${RESET}  ${CYAN}󰋊 disk${RESET}     ${WHITE}${disk}${RESET}"
    echo -e "  ${BOLD}│${RESET}  ${CYAN}󰍛 memory${RESET}   ${WHITE}${memory}${RESET}"
    echo -e "  ${BOLD}│${RESET}  ${CYAN}󰏖 pkgs${RESET}     ${WHITE}${packages}${RESET}"
    echo -e "  ${BOLD}╰────────────╯${RESET}"
    echo ""
}

main() {
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            --image)
                if [ -n "$2" ]; then
                    CUSTOM_IMAGE="$2"
                    shift 2
                else
                    echo -e "${RED}Error: --image requires a path argument${RESET}"
                    exit 1
                fi
                ;;
            --help|-h)
                print_usage
                exit 0
                ;;
            *)
                echo -e "${RED}Unknown option: $1${RESET}"
                print_usage
                exit 1
                ;;
        esac
    done

    print_fetch
}

main "$@"