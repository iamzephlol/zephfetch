            echo -e "  ${T_ICON}󰌽${RESET} ${T_LABEL}os${RESET} ${DIM}⋅⋅⋅${RESET} ${T_VALUE}${os}${RESET}"
            echo -e "  ${T_ICON}󰒺${RESET} ${T_LABEL}wm${RESET} ${DIM}⋅⋅⋅${RESET} ${T_VALUE}${wm}${RESET}"
            echo -e "  ${T_ICON}󰋊${RESET} ${T_LABEL}disk${RESET} ${DIM}⋅⋅⋅${RESET} ${T_VALUE}${disk}${RESET}"
            echo -e "  ${T_ICON}󰍛${RESET} ${T_LABEL}memory${RESET} ${DIM}⋅⋅⋅${RESET} ${T_VALUE}${memory}${RESET}"
            echo -e "  ${T_ICON}󰏖${RESET} ${T_LABEL}pkgs${RESET} ${DIM}⋅⋅⋅${RESET} ${T_VALUE}${packages}${RESET}"
            if [ "$MORE_INFO" = "1" ]; then
                for i in "${!ex_lbl[@]}"; do
                    echo -e "  ${T_ICON}${ex_icons[$i]}${RESET} ${T_LABEL}${ex_lbl[$i]}${RESET} ${DIM}⋅⋅⋅${RESET} ${T_VALUE}${ex_val[$i]}${RESET}"
                done
            fi ;;
        retro)
            echo -e "  ${T_LABEL}USER:${RESET}      ${T_VALUE}${user}${RESET}"
            echo -e "  ${T_LABEL}KERNEL:${RESET}    ${T_VALUE}${kernel}${RESET}"
            echo -e "  ${T_LABEL}OS:${RESET}        ${T_VALUE}${os}${RESET}"
            echo -e "  ${T_LABEL}WM:${RESET}        ${T_VALUE}${wm}${RESET}"
            echo -e "  ${T_LABEL}DISK:${RESET}      ${T_VALUE}${disk}${RESET}"
            echo -e "  ${T_LABEL}MEMORY:${RESET}    ${T_VALUE}${memory}${RESET}"
            echo -e "  ${T_LABEL}PKGS:${RESET}      ${T_VALUE}${packages}${RESET}"
            if [ "$MORE_INFO" = "1" ]; then
                for i in "${!ex_lbl[@]}"; do
                    echo -e "  ${T_LABEL}$(printf '%-11s' "$(echo "${ex_lbl[$i]}" | LC_ALL=C tr '[:lower:]' '[:upper:]'):")${RESET}${T_VALUE}${ex_val[$i]}${RESET}"
                done
            fi ;;
        json)
            local jk=(user kernel os wm disk memory packages)
            local jv=("$user" "$kernel" "$os" "$wm" "$disk" "$memory" "$packages")
            if [ "$MORE_INFO" = "1" ]; then
                jk+=(host resolution cpu gpu swap shell terminal uptime)
                jv+=("${ex_val[@]}")
            fi
            last=$(( ${#jk[@]} - 1 ))
            echo -e "  {"
            for i in "${!jk[@]}"; do
                c=","; [ $i -eq $last ] && c=""
                echo -e "    ${T_LABEL}\"${jk[$i]}\"${RESET}: ${T_VALUE}\"${jv[$i]}\"${RESET}${c}"
            done
            echo -e "  }" ;;
        compact)
            echo -e "${T_ICON}󰣇${RESET} ${T_LABEL}user${RESET}:${T_VALUE} ${user}${RESET}  ${T_ICON}󰌛${RESET} ${T_LABEL}kernel${RESET}:${T_VALUE} ${kernel}${RESET}  ${T_ICON}󰌽${RESET} ${T_LABEL}os${RESET}:${T_VALUE} ${os}${RESET}"
            echo -e "${T_ICON}󰒺${RESET} ${T_LABEL}wm${RESET}:${T_VALUE} ${wm}${RESET}  ${T_ICON}󰋊${RESET} ${T_LABEL}disk${RESET}:${T_VALUE} ${disk}${RESET}  ${T_ICON}󰍛${RESET} ${T_LABEL}mem${RESET}:${T_VALUE} ${memory}${RESET}"
            echo -e "${T_ICON}󰏖${RESET} ${T_LABEL}pkgs${RESET}:${T_VALUE} ${packages}${RESET}"
            if [ "$MORE_INFO" = "1" ]; then
                for ((i=0; i<${#ex_lbl[@]}; i+=3)); do
                    line=""; sep=""
                    for ((j=i; j<i+3 && j<${#ex_lbl[@]}; j++)); do
                        line+="$sep${T_ICON}${ex_icons[$j]}${RESET} ${T_LABEL}${ex_lbl[$j]}${RESET}:${T_VALUE} ${ex_val[$j]}${RESET}"
                        sep="  "
                    done
                    echo -e "$line"
                done
            fi ;;
    esac
    echo ""
    return $img_rc
}

main() {
    while [[ $# -gt 0 ]]; do
        case $1 in
            --image) [ -n "$2" ] && { CUSTOM_IMAGE="$2"; shift 2; } || { echo -e "${RED}Error: --image requires a path argument${RESET}"; exit 1; } ;;
            --update|-u) self_update; exit $? ;;
            --theme|-t) [ -n "$2" ] && { THEME="$2"; shift 2; } || { echo -e "${RED}Error: --theme requires a name argument${RESET}"; exit 1; } ;;
            --thm[1-9]|--thm10) THEME="${1#--}"; shift ;;
            -mi|--more-info|--mi) MORE_INFO=1; shift ;;
            --list-themes) list_themes; exit 0 ;;
            --help|-h) print_usage; exit 0 ;;
            *) echo -e "${RED}Unknown option: $1${RESET}"; print_usage; exit 1 ;;
        esac
    done
    print_fetch
}

main "$@"
